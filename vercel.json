{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync-advertisers",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-deals",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-transactions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/notify-subscribers?tier=instant",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/notify-subscribers?tier=daily",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/notify-subscribers?tier=weekly",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/ppc-outreach?task=send",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/cron/ppc-outreach?task=followup",
      "schedule": "0 9-17 * * 1-5"
    },
    {
      "path": "/api/cron/ppc-outreach?task=sweep",
      "schedule": "30 7 * * *"
    }
  ]
}
