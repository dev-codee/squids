# --- Awin API credentials ---
# OAuth2 bearer token from your Awin account:
#   https://ui.awin.com  ->  Toolbox -> API credentials  (or Account Settings -> API Credentials)
AWIN_API_TOKEN=your_awin_oauth2_token_here

# Your Awin Publisher ID (numeric). Found in your Awin dashboard URL / account settings.
AWIN_PUBLISHER_ID=123456

# --- Geolocation ---
# Fallback country (2-letter ISO code) used when IP geolocation can't determine
# the visitor's country. Defaults to "US" if unset.
# Detection order: Vercel's x-vercel-ip-country header -> ip-api.com -> this.
# (ip-api.com's free tier needs no API key.)
DEFAULT_COUNTRY=US

# --- Cron protection ---
# Any long random string. The /api/cron/* routes require this value.
# Vercel Cron requests are authenticated automatically when this matches the
# Authorization: Bearer <CRON_SECRET> header Vercel sends.
CRON_SECRET=generate_a_long_random_string_here
